# Copy to .env (the dev server does this for you on first run).
# Every value here is a LOCAL DEVELOPMENT placeholder. Production refuses to start with any value
# containing "dev-only", with SMS_PROVIDER=dev, or with ENABLE_DEV_TOOLS=true.

# ── Runtime ────────────────────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# development | test | staging | production. Staging keeps the prototype toolbar; production never does.
APP_ENV=development
# Port of the Node server (API + built SPA).
PORT=3000
# The URL people open. In development Vite serves the SPA on 5173 and proxies /api to PORT.
APP_ORIGIN=http://localhost:5173
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Time travel (/api/dev/clock), "View as", /dev pages. Must be false in production.
ENABLE_DEV_TOOLS=true

# ── Database (infra/docker-compose.dev.yml, port 54320) ────────────────────────────────────
# The app connects as lf_app (DML only, INSERT/SELECT on audit tables).
DATABASE_URL=postgres://lf_app:app-dev-only@localhost:54320/lostfound
# Migrations and test databases use the owner role.
DATABASE_OWNER_URL=postgres://lf_owner:owner-dev-only@localhost:54320/lostfound
DATABASE_POOL_MAX=10

# ── Auth (Better-Auth) ─────────────────────────────────────────────────────────────────────
# At least 32 characters. Signs session cookies.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-0000
# University SSO. Locally: mock-oauth2-server. Later: https://login.microsoftonline.com/<tenant>/v2.0
OIDC_ISSUER=http://localhost:8090/nsu
OIDC_CLIENT_ID=nsu-lost-and-found
OIDC_CLIENT_SECRET=dev-only-oidc-client-secret

# ── Email ──────────────────────────────────────────────────────────────────────────────────
# smtp (Mailpit locally, any SMTP provider later) | memory (tests only)
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="NSU Lost & Found <no-reply@lostfound.localhost>"

# ── SMS ────────────────────────────────────────────────────────────────────────────────────
# dev = DevSmsAdapter: logs the code and shows it at /dev/sms. Refused in production.
SMS_PROVIDER=dev

# ── Object storage (MinIO locally, Cloudflare R2 later) ───────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9100
STORAGE_REGION=auto
STORAGE_BUCKET=lostfound-dev
STORAGE_ACCESS_KEY_ID=lf-dev-minio
STORAGE_SECRET_ACCESS_KEY=minio-dev-only-password
STORAGE_FORCE_PATH_STYLE=true

# ── Encryption of private details (AES-256-GCM) ────────────────────────────────────────────
# Key ring "version:base64(32 bytes)", comma separated. Old versions stay for decrypting old rows.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PRIVATE_DETAILS_KEYS=1:ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=
# Version used for new rows.
PRIVATE_DETAILS_KEY_VERSION=1
