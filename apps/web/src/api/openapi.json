    "/api/dev/clock": {
      "get": {
        "tags": [
          "dev"
        ],
        "summary": "Dev only: the server clock",
        "responses": {
          "200": {
            "description": "Server time.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevClock"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "dev"
        ],
        "summary": "Dev only: move the server clock forward, or reset it",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "advanceMs": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 31622400000
                      }
                    },
                    "required": [
                      "advanceMs"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "reset": {
                        "type": "boolean",
                        "enum": [
                          true
                        ]
                      }
                    },
                    "required": [
                      "reset"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server time after the change.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevClock"
                }
              }
            }
          }
        }
      }
    },
    "/api/dev/sms": {
      "get": {
        "tags": [
          "dev"
        ],
        "summary": "Dev only: text messages the dev SMS adapter would have sent",
        "responses": {
          "200": {
            "description": "Newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "to": {
                            "type": "string"
                          },
                          "body": {
                            "type": "string"
                          },
                          "at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "required": [
                          "to",
                          "body",
                          "at"
                        ]
                      }
                    }
                  },
                  "required": [
                    "messages"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
