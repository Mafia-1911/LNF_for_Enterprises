{
  "name": "@lf/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "dev": "tsx src/dev-prepare.ts && tsx watch --clear-screen=false src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@hono/node-server": "2.1.6",
    "@hono/zod-openapi": "1.6.3",
    "@lf/contracts": "workspace:*",
    "@lf/domain": "workspace:*",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "nodemailer": "10.4.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.1",
    "pino": "10.4.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0"
  }
}
